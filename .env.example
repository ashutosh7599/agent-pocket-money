# setup.sh generates a random local ADMIN key in .env.
WALLET_API_KEYS=

# Wallet API endpoint used by the Python MCP server.
WALLET_API_BASE_URL=http://127.0.0.1:8080

# MCP server configuration.
MCP_AGENT_ALLOWLIST_FILE=agents.json
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_REQUESTS_PER_MINUTE_PER_AGENT=120
MCP_ALLOW_REMOTE_BIND=false

# Add wallet-scoped API keys here after issuing AGENT credentials in the API.
# Example: MCP_ALICE_WALLET_API_KEY=aw_...
